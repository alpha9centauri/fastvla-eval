# Every path the post-training pipeline needs, in one place.
#
# The values below are the ones used on the box these numbers were measured on (gpu5).
# They are an EXAMPLE, not a requirement: nothing here is portable, and every script in
# this directory reads these names rather than hardcoding a path. Copy this file, edit it,
# and `source` it (shell) or point POSTTRAIN_CONFIG at it (Python).
#
# Sources for the copied scripts are named in each file's header.

# --- the raw LeRobot dataset, as downloaded -----------------------------------------
POSTTRAIN_LEROBOT_ROOT=/data_new/vchandr2/libero_safety_data
# meta/ inside the dataset root is used when present; this is the fallback
POSTTRAIN_LEROBOT_META=/data_new/vchandr2/libero_safety_meta/datasets--LIBERO-Safety--libero_safety/snapshots/2ed336d5622b5849b565114de0684547074c7058/meta

# --- the converted RLDS/TFDS builds --------------------------------------------------
POSTTRAIN_RLDS_FULL=/data_new/vchandr2/rlds_full
POSTTRAIN_MIX_ROOT=/data_new/vchandr2/ft_liftonly_data

# --- checkpoints ----------------------------------------------------------------------
POSTTRAIN_RUN_ROOT=/data_new/vchandr2/runs
POSTTRAIN_BASE_CKPT=/data_new/vchandr2/runs/openvla-7b-oft-libero-combined+libero_safety+b32+lr-0.0005+lora-r32+dropout-0.0--image_aug--libero_safety--warmstart-combined--headinit--17500_chkpt
POSTTRAIN_BASE_STEP=17500

# --- the third-party tree the recipe runs from -----------------------------------------
POSTTRAIN_OPENVLA_OFT=/data_new/vchandr2/openvla-oft
POSTTRAIN_PYTHON=/data_new/vchandr2/miniconda3/envs/libero-vla-finetune/bin/torchrun

# --- which GPU. GPU 0 belongs to someone else on this box. -------------------------------
POSTTRAIN_CUDA_DEVICE=1
